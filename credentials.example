; ICANN Client Credentials File
; 
; This file uses INI format with profiles (sections).
; Default location: ~/.icann/credentials
; Override with ICANN_SHARED_CREDENTIALS_FILE environment variable
;
; Default profile: "default"
; Override with ICANN_PROFILE environment variable or --profile flag

; ============================================================================
; Default Profile (Basic Authentication)
; ============================================================================
[default]
auth_type = basic
username  = your_username
password  = your_password
tld       = example
environment = prod    ; prod | ote
version     = v2      ; default v2
role        = registry  ; registry | registrar

; Note: For cert auth with encrypted private keys, add:
; key_passphrase = your_passphrase_here

; ============================================================================
; Example Profile for a Specific TLD (Basic Auth)
; ============================================================================
[example]
auth_type = basic
username  = myuser
password  = mypass
tld       = example
environment = prod
version     = v2
role        = registry

; ============================================================================
; OTE Environment Profile (Basic Auth)
; ============================================================================
[example-ote]
auth_type = basic
username  = ote_user
password  = ote_pass
tld       = example
environment = ote
version     = v2
role        = registry

; ============================================================================
; Certificate Authentication (TLS client cert)
; ============================================================================
; For cert auth, you need certificate_pem and key_pem.
; 
; IMPORTANT: PEM data must be properly formatted. Use ONE of these formats:
;
; Format 1: Multi-line (RECOMMENDED - paste PEM blocks directly)
;   - The BEGIN line can be on the same line as the key or on the next line
;   - Each line of the certificate/key must be on its own line
;   - The END line must be on its own line
;
; Format 2: Single-line with \n escape sequences
;   - Use literal \n characters to separate lines
;   - Example: certificate_pem = -----BEGIN CERTIFICATE-----\nMIIF...\n-----END CERTIFICATE-----
;
; DO NOT use spaces instead of newlines - this will cause parsing errors!

; Multi-line format (RECOMMENDED)
[example-cert]
auth_type = cert
certificate_pem = -----BEGIN CERTIFICATE-----
MIIFXTCCAkWgAwIBAgIJAKZ7D...
MIIFXTCCAkWgAwIBAgIJAKZ7D...
MIIFXTCCAkWgAwIBAgIJAKZ7D...
-----END CERTIFICATE-----
key_pem = -----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA...
MIIEowIBAAKCAQEA...
MIIEowIBAAKCAQEA...
-----END RSA PRIVATE KEY-----
tld = example
environment = prod
version = v2
role = registry

; For encrypted private keys, add the passphrase:
[example-cert-encrypted]
auth_type = cert
certificate_pem = -----BEGIN CERTIFICATE-----
MIIFXTCCAkWgAwIBAgIJAKZ7D...
-----END CERTIFICATE-----
key_pem = -----BEGIN ENCRYPTED PRIVATE KEY-----
MIIEowIBAAKCAQEA...
-----END ENCRYPTED PRIVATE KEY-----
key_passphrase = your_encryption_passphrase_here
tld = example
environment = prod
version = v2
role = registry

; Alternative: Single-line format with \n escapes
[example-cert-singleline]
auth_type = cert
certificate_pem = -----BEGIN CERTIFICATE-----\nMIIFXTCCAkWgAwIBAgIJAKZ7D...\nMIIFXTCCAkWgAwIBAgIJAKZ7D...\n-----END CERTIFICATE-----
key_pem = -----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----
tld = example
environment = ote
version = v2
role = registry

; ============================================================================
; Registrar Role Example
; ============================================================================
[registrar-example]
auth_type = basic
username  = registrar_user
password  = registrar_pass
tld       = example
environment = prod
version     = v2
role        = registrar  ; Registrar role

; ============================================================================
; Field Reference
; ============================================================================
; Required fields:
;   - auth_type: "basic" or "cert"
;   - tld: Top-level domain name
;
; For basic auth:
;   - username: Your ICANN username
;   - password: Your ICANN password
;
; Usernames, passwords and key_passphrase are read exactly as written, so they
; may contain "#" and ";" without quoting or escaping. To keep leading or
; trailing spaces, wrap the value in double quotes: password = "  padded  "
;
; The other fields (auth_type, tld, environment, version, role) support the
; trailing "; comment" style used above, so their values must not contain
; "#" or ";".
;
; For cert auth:
;   - certificate_pem: PEM-encoded certificate (must be multi-line or use \n escapes)
;   - key_pem: PEM-encoded private key (must be multi-line or use \n escapes)
;   - key_passphrase: (optional) Passphrase for decrypting encrypted private keys
;   
;   WARNING: Do NOT put the entire PEM on a single line with spaces!
;   Each line of the PEM must be on its own line, or use \n escape sequences.
;   
;   If your private key is encrypted (-----BEGIN ENCRYPTED PRIVATE KEY-----),
;   you must provide the key_passphrase field with the encryption passphrase.
;
; Optional fields (with defaults):
;   - environment: "prod" (default) or "ote"
;   - version: "v2" (default)
;   - role: "registry" (default) or "registrar"
;
; Note: If the profile section name matches the TLD, you can omit the tld field.

